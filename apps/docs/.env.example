# Base URL of the glokki CMS (https://…). Leave empty to read the pages from the JSON fixtures
# in content/ (dev, tests and CI); when set, CMS_TENANT and CMS_API_KEY are required.
CMS_BASE_URL=

# Tenant slug in glokki, sent as X-Tenant-Slug.
CMS_TENANT=

# Delivery API key of the tenant (server only, never expose it to the browser).
CMS_API_KEY=

# The same tenant slug for the browser: the visual editor (preview) needs it.
NEXT_PUBLIC_CMS_TENANT=

# Set to "production" on the live site: it allows indexing and hides block errors. Any other value
# (or none) sends noindex, Disallow: / in robots.txt and shows block errors.
APP_ENV=

# Secret of the revalidation webhook: POST /api/revalidate with "Authorization: Bearer <secret>"
# (or an x-revalidate-secret header). Without it the endpoint always answers 401.
REVALIDATE_SECRET=

# Secret of the preview route: GET /preview?slug=<slug> with "Authorization: Bearer <secret>", an
# x-preview-secret header or ?secret=<secret> turns on draft mode and redirects to the page.
# Without it the route always answers 401.
PREVIEW_SECRET=

# Admin API key of the tenant for `pnpm --filter docs seed` (glokki MCP). Only on the machine of the
# maintainer, never on the server of the site. Create it in Settings → API Keys with the scopes
# mcp:connect, admin:pages:read, admin:pages:write and admin:pages:publish.
CMS_ADMIN_API_KEY=

# Public base URL of the site, used for canonical links, Open Graph and sitemap.xml. Falls back
# to http://localhost:3100 (the local `pnpm --filter docs start`).
SITE_URL=
