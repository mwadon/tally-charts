{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-examples.mjs && node scripts/gen-api.mjs && node scripts/gen-tokens.mjs",
    "dev": "pnpm gen && next dev -p 3000",
    "build": "pnpm gen && next build",
    "start": "next start -p 3100",
    "typecheck": "pnpm gen && next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test": "pnpm gen && vitest run",
    "check:content": "pnpm gen && tsx scripts/check-content.ts",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@glokki-cms/react": "0.10.0",
    "@glokki-cms/sdk": "0.17.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tally-charts": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
