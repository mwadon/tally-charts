{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/__snapshots__",
      "!docs/superpowers/specs/assets",
      "!packages/tally-charts/api/*.api.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["**/*.test.tsx"],
      "linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
    }
  ],
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
